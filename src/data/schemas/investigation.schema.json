{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NASA PSI Investigation Record",
  "type": "object",
  "required": [
    "id",
    "psiId",
    "code",
    "title",
    "rack",
    "rackFull",
    "fuelType",
    "fuelDetails",
    "airflowRange",
    "variables",
    "sensors",
    "summary",
    "lunarHabWeight",
    "materialPrevWeight",
    "smokeDetWeight",
    "suppressionWeight",
    "resourceClassification",
    "psiUrl"
  ],
  "properties": {
    "id": { "type": "string" },
    "psiId": { "type": "string" },
    "code": { "type": "string" },
    "title": { "type": "string" },
    "rack": { "type": "string", "enum": ["CIR", "MSG", "CYGNUS", "LUNAR"] },
    "rackFull": { "type": "string" },
    "fuelType": { "type": "string" },
    "fuelDetails": { "type": "string" },
    "airflowRange": { "type": "string" },
    "variables": { "type": "string" },
    "sensors": { "type": "string" },
    "summary": { "type": "string", "minLength": 20 },
    "lunarHabWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "materialPrevWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "smokeDetWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "suppressionWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "dataSize": { "type": "string" },
    "version": { "type": "string" },
    "releaseDate": { "type": "string" },
    "license": { "type": "string" },
    "resourceClassification": {
      "type": "string",
      "enum": [
        "Verified experimental numerical data",
        "Experimental images or videos",
        "Research publications",
        "Technical reports",
        "Investigation metadata",
        "Ground-based experimental data",
        "Numerical simulation or computational model",
        "Planned / Conceptual (Non-Archived)",
        "Unavailable or restricted resource"
      ]
    },
    "availableProducts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "downloadMethod": { "type": "string" },
    "doi": { "type": "string" },
    "psiUrl": { "type": "string", "format": "uri" },
    "verified": { "type": "boolean" },
    "provenanceNote": { "type": "string" }
  }
}
