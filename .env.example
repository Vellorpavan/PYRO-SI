# Environment Variables (Example Template)
# Never commit real API keys to version control.

# Google Gemini API (for Research Co-Pilot RAG Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud Platform (Optional Backend & Ingestion)
GCP_PROJECT_ID=pyro-si-nasa-2026
GCP_STORAGE_BUCKET=pyro-si-psi-datasets
GCP_REGION=us-central1

# NASA Physical Sciences Informatics (PSI) Open API / Proxy
NASA_PSI_API_BASE=https://psi.nasa.gov/api/v1
NASA_API_KEY=DEMO_KEY

# Parse.bot Scraper Shared Service Secret (for NASA Combustion Data Retrieval)
# Server-side environment secret only; never exposed to client/frontend users.
# Configure this once in your deployment environment (e.g. Cloud Run, Render, Railway, AWS ECS).
PARSE_API_KEY=your_parse_api_key_here

# Application Client Authorization Token (secures backend proxy from public scraping abuse)
APP_SECRET_TOKEN=pyro-app-auth-token-2026

# Application Runtime Configuration
PORT=3000
NODE_ENV=development
